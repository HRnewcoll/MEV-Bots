ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
ETH_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_KEY
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

CHAIN=ethereum
TRADE_AMOUNT=0.1
MIN_PROFIT_ETH=0.002
MAX_GAS_PRICE_GWEI=100
POLL_INTERVAL=1.0
SKIP_ON_BEARISH=true

# Price predictor model
PP_INPUT_SIZE=16
PP_HIDDEN_SIZE=128
PP_NUM_LAYERS=2
PP_SEQ_LEN=30
PP_CHECKPOINT=checkpoints/price_predictor.pt

# Opportunity classifier
CLF_FEATURE_DIM=32
CLF_CHECKPOINT=checkpoints/opp_classifier.pkl

# RL agent
RL_CHECKPOINT=checkpoints/rl_agent
RL_TOTAL_TIMESTEPS=100000
RL_UPDATE_EVERY=500
RL_TENSORBOARD_LOG=logs/tensorboard

# Flashbots (optional)
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
FLASHBOTS_SIGNER_KEY=0xYOUR_FLASHBOTS_SIGNER_KEY
