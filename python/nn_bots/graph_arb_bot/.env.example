ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org/
POLYGON_RPC_URL=https://polygon-rpc.com

PRIVATE_KEY=0xYOUR_PRIVATE_KEY

FLASHBOTS_RELAY_URL=https://relay.flashbots.net
FLASHBOTS_SIGNER_KEY=0xYOUR_FLASHBOTS_SIGNER_KEY

# Chain to trade on: ethereum | bsc | polygon | avalanche | arbitrum
CHAIN=ethereum

# Trading parameters
MIN_PROFIT_ETH=0.001
MAX_GAS_PRICE_GWEI=100
TRADE_AMOUNT=0.1
SLIPPAGE_BPS=50
POLL_INTERVAL=1.0

# GNN model hyperparameters
GNN_HIDDEN_DIM=64
GNN_NUM_LAYERS=3

# Maximum hop count in path search (2 = single intermediate token)
MAX_PATH_LENGTH=2

# Path to pre-trained model weights (generated by training/train.py)
GNN_CHECKPOINT=checkpoints/gnn_arb.pt
